# Path to the Google Service Account credentials JSON file
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json

# Google Spreadsheet ID (from the sheet URL)
# e.g. https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=your-spreadsheet-id-here

# Razorpay Test Mode keys
# Get from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Razorpay Webhook Secret (optional, for webhook signature verification)
# Set in Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Email / SMTP (Gmail example)
# For Gmail: enable 2FA → create App Password → use that as SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com
BUSINESS_NAME=FlowPay
