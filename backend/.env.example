# Path to the Google Service Account credentials JSON file
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json

# Google Spreadsheet — paste the FULL URL or just the ID, both work!
# e.g. https://docs.google.com/spreadsheets/d/1Ahb2e.../edit?gid=0
GOOGLE_SHEET_ID=https://docs.google.com/spreadsheets/d/your-spreadsheet-id-here/edit

# Razorpay Test Mode keys
# Get from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Razorpay Webhook Secret (optional, for webhook signature verification)
# Set in Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Email / SMTP (Gmail example)
# For Gmail: enable 2FA → create App Password → use that as SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com
BUSINESS_NAME=FlowPay

# Gemini AI (LangGraph Agent)
GEMINI_API_KEY=your_gemini_api_key_here
